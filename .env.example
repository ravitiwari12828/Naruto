# Naruto Discord Bot Configuration Template

# Discord Bot Credentials
DISCORD_TOKEN=your_discord_bot_token_here
CLIENT_ID=your_client_id_here
PREFIX=.
DEFAULT_EMBED_COLOR=#00E5FF
BANNER_URL=https://i.imgur.com/8QZ5Z2A.png
AVATAR_URL=https://i.imgur.com/8QZ5Z2A.png

# Discord REST API Proxy (Cloudflare Worker Reverse Proxy to bypass IP blocks)
DISCORD_API_URL=https://narut-discord-proxy.<your-subdomain>.workers.dev

# Master Cloud Database (MongoDB Atlas URI for persistence across redeploys)
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/narutobot?retryWrites=true&w=majority

# AI Image Generation (OpenAI API Key for DALL-E 3)
OPENAI_API_KEY=your_openai_api_key_here

# 5TB Automated Cloud Backups (Google Drive Service Account or OAuth)
GOOGLE_DRIVE_FOLDER_ID=your_google_drive_folder_id_here
# Either path to credentials JSON or single-line JSON string
GOOGLE_DRIVE_CREDENTIALS=data/credentials/google-service-account.json

# Primary Lavalink Music Server
LAVALINK_HOST=noida8.visihost.in
LAVALINK_PORT=25648
LAVALINK_PASSWORD=SynnIsLob
LAVALINK_SECURE=false

# Optional Backup Lavalink Node
# BACKUP_LAVALINK_HOST=
# BACKUP_LAVALINK_PORT=
# BACKUP_LAVALINK_PASSWORD=
# BACKUP_LAVALINK_SECURE=false
MUSIC_SEARCH_ENGINE=youtube
